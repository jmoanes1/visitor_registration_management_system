# Frontend environment variables
# No secrets belong here: everything prefixed with VITE_ is embedded in the
# public browser bundle.
#
# Leave unset for local development: vite.config.js proxies /api to the Express
# server on port 5000.
#
# Leave unset on Render too: the Express service serves the built SPA and /api
# from the same domain, so relative requests are already correct.
#
# Only set it when the API lives on a different origin than the frontend, and
# list that same origin in the backend's CORS_ALLOWED_ORIGINS.
# VITE_API_BASE_URL=http://localhost:5000/api
