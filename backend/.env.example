# Backend environment variables
# Copy to backend/.env for local development. Never commit the real .env file.
# In production these are set in the Render dashboard (see render.yaml).

NODE_ENV=development
PORT=5000

# Required. A long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin login. There is no database: exactly one admin account is configured here.
# ADMIN_USERNAME is accepted as an alias of ADMIN_EMAIL.
ADMIN_EMAIL=admin@visitorreg.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin User
JWT_EXPIRES_IN=8h

# Optional. Only needed when the frontend is served from another origin than the
# API. Add that origin here, comma-separated, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=
