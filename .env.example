# Copy this file to .env and fill in the two secrets. Never commit .env.
# One file serves both the API and the Vite dev server.

# Port the Express API listens on. vite.config.js proxies /api here in development.
PORT=5000

# Required for sign-in. Generate a long random string with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The single admin account. This project has no database, so exactly one
# account is configured here.
ADMIN_EMAIL=admin@visitorreg.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin User
JWT_EXPIRES_IN=8h

# Optional. Needed only when the SPA is served from a different origin than the
# API. Comma-separated, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=

# Optional. Needed only when the API is on a different origin than the SPA.
# Leave unset locally: Vite proxies /api to the port above. Everything prefixed
# with VITE_ is embedded in the public browser bundle, so put no secrets here.
# VITE_API_BASE_URL=https://api.example.com/api

# Optional. The API serves dist/ itself when it exists, which is how Render runs
# this app. Set to "production" to tighten CORS for a split-origin deploy.
# NODE_ENV=production
