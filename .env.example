# Local development configuration.
# Copy this file to .env, then replace the placeholder secrets with your own
# values. Never commit the real .env - it is listed in .gitignore.

# Express API port. Vite proxies /api here, so nothing else needs to change.
PORT=5000

# Sign the JWTs with any long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
JWT_SECRET=change-me-to-a-long-random-string

# How long a signed-in session stays valid.
JWT_EXPIRES_IN=8h

# The single sign-in account. Anything else in Staff Management is a directory
# entry, not a login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-you-deploy
ADMIN_NAME=Admin User

# Comma-separated origins, only needed when the SPA is served from a different
# domain than /api. Leave empty for the normal single-process setup.
CORS_ALLOWED_ORIGINS=
